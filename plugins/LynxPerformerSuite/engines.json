{
  "bundle": "LynxPerformerSuite",
  "modules": {
    "performerMatcher": {
      "script": "engines/performerMatcher/plugin.py",
      "enabled": "matcher_enabled",
      "hooks": []
    },
    "attributes": {
      "script": "engines/attributes/performer_attributes.py",
      "enabled": "attributes_enabled",
      "hooks": [
        "Performer.Create.Post",
        "Performer.Update.Post"
      ]
    },
    "performerLinks": {
      "script": "engines/performerLinks/lynx_performer_bridge.py",
      "enabled": "links_enabled",
      "hooks": [
        "Gallery.Create.Post",
        "Gallery.Update.Post",
        "Image.Create.Post",
        "Image.Update.Post"
      ]
    },
    "tagTransfer": {
      "script": "engines/tagTransfer/lynx_tag_bridge.py",
      "enabled": "tags_enabled",
      "hooks": [
        "Gallery.Create.Post",
        "Gallery.Update.Post",
        "Image.Create.Post",
        "Image.Update.Post",
        "Performer.Create.Post",
        "Performer.Update.Post",
        "Scene.Create.Post",
        "Scene.Update.Post"
      ]
    }
  }
}
